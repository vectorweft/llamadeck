# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Build output. Anchored (leading /) on purpose: a bare `build/` matches at
# ANY depth, which silently swallowed frontend/src/routes/build/ — the page
# was written, `git add` said nothing, and the shipped UI linked to a 404.
/dist/
/build/
/frontend/build/

# Frontend
frontend/node_modules/
frontend/.svelte-kit/
# backend/lld/static/ is deliberately NOT ignored: it is the built SvelteKit
# bundle the backend serves, so an install works without a Node toolchain.

# Runtime state — machine-specific, and `state` is a symlink out of the repo
# into ~/.config/llamadeck (settings, presets, tokens, the model DB).
# Anchored for the same reason as build/ above: the bare form also matched
# frontend/src/routes/logs/.
/logs/
state
*.log

# Local scratch
prompt.txt
.claude/

# OS
.DS_Store
